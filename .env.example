# Apollo. Optional: with no key the client replays fixtures/apollo.json.
APOLLO_API_KEY=
# Point at a stub instead of the real API (used by the failure-injection tests).
APOLLO_BASE_URL=

# Model provider. Tried in order; with neither set the agent uses a deterministic
# fallback and the room still completes. LLM_PROVIDER forces one.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
LLM_PROVIDER=
LLM_TIMEOUT_MS=90000

DATABASE_URL=postgres://postgres:postgres@localhost:55434/room
PG_POOL_MAX=8
PORT=3000

# Single-dyno deployment: run the agent loop inside the web process, create the schema
# if missing, and seed a room so a public demo is never an empty page.
WORKER_IN_PROCESS=
MIGRATE_ON_BOOT=
DEMO_SEED=
